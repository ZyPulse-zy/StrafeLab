<UserControl x:Class="StrafeLab.UI.AnalysisPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StrafeLab.UI" Background="#0B0C0A" Foreground="#E8EBDD" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ReviewTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <UserControl.FontFamily><StaticResource ResourceKey="MonoFont"/></UserControl.FontFamily>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
   <DockPanel><Button x:Name="captureBadge" DockPanel.Dock="Right" Content="查看采集状态" Click="CaptureBadge_Click" FontSize="12" Padding="12,6" MinHeight="32" ToolTip="打开采集设置，查看后台采集状态"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 0 16 L 8 0 L 16 0 L 8 16 Z M 13 16 L 21 0 L 29 0 L 21 16 Z" Fill="#C6FF4A" Width="29" Height="18" Margin="0,0,12,0"/><TextBlock Text="StrafeLab" FontWeight="SemiBold" FontSize="25" LineHeight="30"/><Border Background="{StaticResource BorderBrush}" Width="1" Margin="18,3"/><TextBlock Text="CS2 操作分析" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,0,24,0"><DockPanel>
   <TextBlock DockPanel.Dock="Right" Text="1.7  /  本地数据" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
   <StackPanel Orientation="Horizontal"><RadioButton x:Name="navOverview" GroupName="navigation" Content="长期趋势" Tag="0" Checked="Nav_Checked" Style="{StaticResource NavigationItem}"/><RadioButton x:Name="navDetails" GroupName="navigation" Content="比赛复盘" Tag="2" Checked="Nav_Checked" Style="{StaticResource NavigationItem}"/><RadioButton x:Name="navKeyboard" GroupName="navigation" Content="键盘参数" Tag="1" Checked="Nav_Checked" Style="{StaticResource NavigationItem}"/><RadioButton x:Name="navDemos" GroupName="navigation" Content="Demo 资料库" Tag="3" Checked="Nav_Checked" Style="{StaticResource NavigationItem}"/><RadioButton x:Name="navCapture" GroupName="navigation" Content="采集设置" Tag="4" Checked="Nav_Checked" Style="{StaticResource NavigationItem}"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="2" Margin="24,16,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel x:Name="pageHeading" Margin="0,0,12,18"><TextBlock x:Name="pageTitle" Text="长期趋势" FontSize="25" FontWeight="SemiBold" LineHeight="34"/><TextBlock x:Name="pageSubtitle" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" x:Name="tabs"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
   <TabItem x:Name="progressTab" Header="进步与键盘参数"><local:ProgressPage x:Name="progressPage"/></TabItem>
   <TabItem x:Name="detailTab" Header="对局与动作明细">
    <ScrollViewer x:Name="statsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,12,20">
      <Border Background="{StaticResource PanelBrush2}" CornerRadius="0" Padding="14,12,2,4" Margin="0,0,0,14"><StackPanel><WrapPanel>
       <StackPanel><TextBlock Text="日期" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="dateFilter" Width="122" SelectionChanged="Filter_Changed" AutomationProperties.Name="日期筛选"/></StackPanel>
       <StackPanel><TextBlock Text="地图" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="mapFilter" Width="145" SelectionChanged="Filter_Changed" AutomationProperties.Name="地图筛选"/></StackPanel>
       <StackPanel><TextBlock Text="武器" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="weaponFilter" Width="140" SelectionChanged="Filter_Changed" AutomationProperties.Name="武器筛选"/></StackPanel>
       <StackPanel><TextBlock Text="对局" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="sessionFilter" Width="240" SelectedValuePath="Id" SelectionChanged="Filter_Changed" AutomationProperties.Name="对局筛选"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
       <StackPanel><TextBlock Text="姿态" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="stanceFilter" Width="130" SelectionChanged="Filter_Changed" AutomationProperties.Name="姿态筛选"/></StackPanel>
       <StackPanel><TextBlock Text="起步速度" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="speedFilter" Width="140" SelectionChanged="Filter_Changed" AutomationProperties.Name="起速筛选"/></StackPanel>
      </WrapPanel></StackPanel></Border>
      <WrapPanel Margin="0,0,0,12"><Button Content="重置筛选" Click="ResetFilters_Click" Style="{StaticResource QuietButton}"/><Button Content="返回趋势总览" Click="BackToOverview_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
      <TextBlock x:Name="cohortText" Foreground="#A0A795" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,13"/>
      <UniformGrid Columns="4" Margin="0,0,0,16">
       <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="能用于统计的动作" FontSize="12" Foreground="#A0A795"/><TextBlock x:Name="sampleCount" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="已核对录像 · 包含慢走 / 蹲伏" FontSize="12" Foreground="#A0A795" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="记录到的换向开枪" FontSize="12" Foreground="#A0A795"/><TextBlock x:Name="lowRate" Text="—" FontSize="30" FontWeight="SemiBold" Foreground="#C6FF4A" Margin="0,8,0,3"/><TextBlock x:Name="lowDetail" Text="等待可靠匹配" FontSize="12" Foreground="#A0A795" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="两键同按 · 典型时长" FontSize="12" Foreground="#A0A795"/><TextBlock x:Name="overlapMedian" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="gapMedian" Text="双键空档 —" FontSize="12" Foreground="#A0A795"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="换向后多久开枪" FontSize="12" Foreground="#A0A795"/><TextBlock x:Name="timingMedian" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="典型时长 · 不是建议等待时间" FontSize="12" Foreground="#A0A795" TextWrapping="Wrap"/></StackPanel></Border>
      </UniformGrid>
      <Expander Header="查看未计入原因" Foreground="#A0A795" Margin="0,0,0,14"><TextBlock x:Name="exclusionText" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/></Expander>
      <TextBlock Text="逐局记录 · 点击一局查看动作" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <DataGrid x:Name="matchGrid" Height="175" SelectionChanged="Match_Selected" Margin="0,0,0,16">
       <DataGrid.Columns><DataGridTextColumn Header="本地时间" Binding="{Binding LocalTime}" Width="110"/><DataGridTextColumn Header="地图" Binding="{Binding Map}" Width="*"/><DataGridTextColumn Header="候选动作" Binding="{Binding Count}" Width="80"/><DataGridTextColumn Header="可评估" Binding="{Binding EligibleCount}" Width="80"/><DataGridTextColumn Header="Demo" Binding="{Binding DemoStatus}" Width="*"/><DataGridTextColumn Header="同步残差 ms" Binding="{Binding Alignment.ResidualRmsMs,StringFormat=F1,TargetNullValue=—}" Width="115"/></DataGrid.Columns>
      </DataGrid>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="导出当前筛选 CSV" Click="Export_Click"/><TextBlock Text="动作明细" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <ComboBox x:Name="cohortFilter" Width="215" HorizontalAlignment="Left" SelectionChanged="Filter_Changed"/><TextBlock x:Name="actionEmpty" Style="{StaticResource Caption}" Margin="0,4,0,12" Visibility="Collapsed"/><DataGrid x:Name="actionGrid" Height="260" SelectionChanged="Action_Selected">
       <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="105"/><DataGridTextColumn Header="回合" Binding="{Binding RoundText}" Width="45"/><DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="55"/><DataGridTextColumn Header="武器" Binding="{Binding Weapon}" Width="90"/><DataGridTextColumn Header="空档 ms" Binding="{Binding GapMs,StringFormat=F1,TargetNullValue=—}" Width="85"/><DataGridTextColumn Header="同按 ms" Binding="{Binding OverlapMs,StringFormat=F1,TargetNullValue=—}" Width="85"/><DataGridTextColumn Header="开枪间隔 ms" Binding="{Binding ClickMs,StringFormat=F1}" Width="112"/><DataGridTextColumn Header="速度 u/s" Binding="{Binding Speed,StringFormat=F1,TargetNullValue=—}" Width="90"/><DataGridTextColumn Header="速度变化" Binding="{Binding BrakeDescription}" Width="110"/><DataGridTextColumn Header="统计分组" Binding="{Binding Cohort}" Width="135"/><DataGridTextColumn Header="计入 / 原因" Binding="{Binding EligibilityText}" Width="230"/></DataGrid.Columns>
      </DataGrid>
      <Border Style="{StaticResource CardStyle}" Margin="0,12,0,12"><StackPanel><TextBlock x:Name="actionStory" FontSize="14" Foreground="#E8EBDD" TextWrapping="Wrap"/><local:InputTimeline x:Name="inputTimeline" Height="210" Margin="0,8,0,0"/><Expander Header="展开原始速度、时间匹配和排除原因" Foreground="#A0A795"><TextBlock x:Name="actionDetail" Margin="0,10,0,12" Foreground="#A0A795" TextWrapping="Wrap"/></Expander></StackPanel></Border>
      <Expander Header="按武器、姿态与方向展开比较" Margin="0,8,0,16" Foreground="{StaticResource MutedBrush}"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="同类动作比较 · 蹲姿和慢走同样保留" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="按武器 × 姿态 × 起速分组；轴向降速 = 原方向分量 − 开枪时该轴速度大小，负值表示更快。它包含摩擦、蹲起或受击等共同影响，不等于射击精度，也不是按键制动的独立贡献。" FontSize="12" Foreground="#A0A795" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <DataGrid x:Name="groupGrid" Height="185" Margin="0,0,0,16"><DataGrid.Columns>
       <DataGridTextColumn Header="武器" Binding="{Binding Weapon}" Width="105"/><DataGridTextColumn Header="姿态" Binding="{Binding Stance}" Width="95"/><DataGridTextColumn Header="起速 u/s" Binding="{Binding InitialSpeedBand}" Width="115"/><DataGridTextColumn Header="样本" Binding="{Binding Count}" Width="55"/>
       <DataGridTextColumn Header="起速中位数" Binding="{Binding Before,StringFormat=F1,TargetNullValue=—}" Width="*"/><DataGridTextColumn Header="开枪速度" Binding="{Binding AtShot,StringFormat=F1,TargetNullValue=—}" Width="*"/><DataGridTextColumn Header="轴向降速 u/s" Binding="{Binding AxisDrop,StringFormat=F1,TargetNullValue=—}" Width="*"/>
      </DataGrid.Columns></DataGrid>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
       <StackPanel><TextBlock Text="对局趋势" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="trendText" Foreground="#A0A795" FontSize="12" Margin="0,5,0,5" TextWrapping="Wrap"/><local:AnalysisTrendChart x:Name="trendChart" Height="144"/>
       <TextBlock Text="黄绿：可评估动作数　灰白：同按中位数（ms）　旧 → 新；未匹配 Demo 不绘制动作数点" Foreground="#A0A795" FontSize="12" TextWrapping="Wrap"/></StackPanel>
      </Border>
      <TextBlock Text="方向对比" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <DataGrid x:Name="directionGrid" Height="153" Margin="0,0,0,16">
       <DataGrid.Columns>
        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="*"/><DataGridTextColumn Header="样本" Binding="{Binding Count}" Width="65"/>
        <DataGridTextColumn Header="空档 ms" Binding="{Binding Gap}" Width="*"/><DataGridTextColumn Header="同按 ms" Binding="{Binding Overlap}" Width="*"/>
        <DataGridTextColumn Header="持键 ms" Binding="{Binding Hold}" Width="*"/><DataGridTextColumn Header="开枪间隔 ms" Binding="{Binding Click}" Width="*"/><DataGridTextColumn Header="轴向降速 u/s" Binding="{Binding Drop}" Width="115"/>
       </DataGrid.Columns>
      </DataGrid>
      </StackPanel></Expander>
      <Border Background="#181A17" Padding="13" CornerRadius="0"><TextBlock Text="统计口径 v4：反向前三 tick 的水平速度中位数低于 34 u/s 不计入，等于 34 保留；按未四舍五入值判断。慢走、蹲伏、蹲起不直接排除，按武器与姿态分组。仍需可信反向输入、原方向运动分量和连续 Demo。排除样本保留明细，不算成功或失败。34 是初速统计门槛；开枪速度和轴向减速另行展示，不代表全枪械统一精度或成功率。" FontSize="12" Foreground="#A0A795" TextWrapping="Wrap"/></Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="jobsTab" Header="Demo 后台任务"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,24">
    <Border Style="{StaticResource CardStyle}"><StackPanel><DockPanel><Button x:Name="importDemo" DockPanel.Dock="Right" Content="导入 Demo / 压缩包" Click="Import_Click" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0"/><TextBlock Text="下载后，自动接着复盘" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="平台录像需先下载到本机。监控目录中的 .dem、.zip、.dem.bz2 稳定后自动分析；游戏中等待，退出后继续。" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
     <WrapPanel Margin="0,18,0,0"><CheckBox x:Name="enabledBox" Content="自动后台分析" Checked="Enabled_Changed" Unchecked="Enabled_Changed" VerticalAlignment="Center" Margin="0,0,18,8"/><Button Content="立即扫描" Click="Scan_Click" Margin="0,0,10,8"/><Button x:Name="retryJobs" Content="重试失败 / 未匹配" Click="Retry_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="jobNotice" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
    <WrapPanel Margin="0,20,0,16"><Border Background="#181A17" CornerRadius="0" Padding="12,8" Margin="0,0,10,8"><TextBlock x:Name="jobsComplete" Text="已完成 0" Foreground="#C6FF4A"/></Border><Border Background="#181A17" CornerRadius="0" Padding="12,8" Margin="0,0,10,8"><TextBlock x:Name="jobsWaiting" Text="处理中 0"/></Border><Border Background="#181A17" CornerRadius="0" Padding="12,8" Margin="0,0,10,8"><TextBlock x:Name="jobsAttention" Text="待核对 0" Foreground="#C6FF4A"/></Border></WrapPanel>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="157"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="任务状态" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="jobFilter" Width="145" Margin="0,0,12,0" SelectionChanged="JobFilter_Changed" AutomationProperties.Name="Demo 任务状态筛选"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="查找文件名或路径" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="jobSearch" TextChanged="JobSearch_Changed" AutomationProperties.Name="搜索 Demo 文件名" ToolTip="按文件名或路径查找"/></StackPanel></Grid>
    <TextBlock x:Name="jobEmpty" Style="{StaticResource Caption}" Margin="0,0,0,12" Visibility="Collapsed"/>
    <DataGrid x:Name="jobGrid" Height="300" SelectionChanged="Job_Selected" AutomationProperties.Name="Demo 分析任务"><DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*" MinWidth="220"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="95"/><DataGridTextColumn Header="尝试次数" Binding="{Binding Attempts}" Width="90"/><DataGridTextColumn Header="文件更新时间" Binding="{Binding UpdatedLocal}" Width="136"/></DataGrid.Columns></DataGrid>
    <Border Background="#181A17" CornerRadius="0" Padding="16" Margin="0,12,0,22"><TextBlock x:Name="jobDetail" Text="选择一个文件，查看匹配结果或未完成原因。" TextWrapping="Wrap"/></Border>
    <Expander Header="管理自动扫描的目录"><StackPanel Margin="0,12,0,0"><TextBlock Text="下载位置变了，添加所在目录即可。手动导入可直接选择任意位置的文件。移除目录不会删除文件。" Style="{StaticResource Caption}" Margin="0,0,0,12"/><WrapPanel><Button x:Name="addRoot" Content="添加目录" Click="AddRoot_Click" Margin="0,0,10,12"/><Button x:Name="removeRoot" Content="移除所选目录" Click="RemoveRoot_Click" Margin="0,0,0,12"/></WrapPanel><ListBox x:Name="rootList" Height="152" AutomationProperties.Name="Demo 监控目录"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="3,5"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="captureTab"><local:CapturePage x:Name="capturePage"/></TabItem>
  </TabControl>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,7"><DockPanel><TextBlock DockPanel.Dock="Right" Text="数据保存在本机" Style="{StaticResource Caption}" Margin="20,0,0,0"/><TextBlock x:Name="backgroundStatus" Text="读取本地报告…" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</UserControl>
