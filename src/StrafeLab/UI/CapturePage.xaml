<UserControl x:Class="StrafeLab.UI.CapturePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,12,24">
  <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"><StackPanel>
   <TextBlock Text="后台采集" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="state" Text="正在读取状态…" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,8"/>
   <TextBlock Text="登录后进入系统托盘，发现 CS2 后启动采集；进入自己的对局才记录。关闭统计窗口不影响后台采集。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
   <WrapPanel Margin="0,18,0,8"><Button x:Name="start" Content="启动后台采集" Click="Start_Click" Margin="0,0,12,0" Style="{StaticResource PrimaryButton}"/><Button x:Name="pause" Content="暂停采集" Click="Pause_Click" Margin="0,0,12,0"/><Button Content="退出后台采集" Click="Stop_Click"/></WrapPanel>
   <CheckBox x:Name="startup" Content="登录 Windows 后自动启动后台采集" Foreground="{StaticResource TextBrush}" Margin="0,12,0,4" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
   <TextBlock x:Name="startupDetail" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <CheckBox x:Name="hallEnabled" Content="采集 Hall 连续键程" Foreground="{StaticResource TextBrush}" Margin="0,16,0,4" Checked="Hall_Changed" Unchecked="Hall_Changed"/>
   <TextBlock Text="使用官方驱动调整设置前，可关闭 Hall 监测；Raw Input 仍然记录实际按键。空闲时不连接键盘。" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="message" Foreground="{StaticResource WarnBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="采集进程内存" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="memory" Text="—" FontSize="30" Margin="0,12,0,8"/><TextBlock x:Name="privateMemory" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="这里显示采集进程工作集；统计窗口、Demo 解析另计。正在记录时，占用随对局长度增加。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="连接与记录" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="gsi" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock x:Name="hall" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="inputs" Margin="0,12,0,0"/></StackPanel></Border>
  </Grid>
  <TextBlock Text="资源如何使用" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <TextBlock Text="空闲：每 3 秒检查 CS2 是否运行，不打开输入与键盘接口。&#10;游戏中：采集 Raw Input、Hall 与 GSI；每 5 秒保存一次。&#10;退出游戏后：自动扫描下载目录，单独解析 Demo，完成后释放解析进程。&#10;游戏再次启动时：暂停 Demo 解析，未完成的任务稍后继续。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="26"/>
  <Button Content="打开本地数据文件夹" Click="OpenData_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
