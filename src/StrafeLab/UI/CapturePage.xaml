<UserControl x:Class="StrafeLab.UI.CapturePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ReviewTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer x:Name="pageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,24">
  <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"><StackPanel>
   <TextBlock Text="后台采集" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="state" Text="正在读取状态…" FontSize="25" FontWeight="SemiBold" LineHeight="34" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,8" TextWrapping="Wrap"/>
   <TextBlock Text="打开统计窗口不是采集的必要条件。后台在系统托盘运行，进入自己的 CS2 对局后才记录。" Style="{StaticResource Caption}"/>
   <WrapPanel Margin="0,18,0,8"><Button x:Name="start" Content="启动后台采集" Click="Start_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button x:Name="pause" Content="暂停采集" Click="Pause_Click" Margin="0,0,12,8"/><Button x:Name="stop" Content="退出后台采集" Click="Stop_Click" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="message" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
   <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0"><StackPanel>
    <CheckBox x:Name="startup" Content="登录 Windows 后自动采集" Checked="Startup_Changed" Unchecked="Startup_Changed"/><TextBlock x:Name="startupDetail" Style="{StaticResource Caption}" Margin="26,5,0,14"/>
    <CheckBox x:Name="hallEnabled" Content="读取 Hall 连续键程" Checked="Hall_Changed" Unchecked="Hall_Changed"/><TextBlock Text="使用官方驱动调参数前，可先关闭 Hall 监测。实际按键仍由 Raw Input 记录；空闲时不占用键盘接口。" Style="{StaticResource Caption}" Margin="26,5,0,0"/>
   </StackPanel></Border>
  </StackPanel></Border>
  <Border Background="#181A17" CornerRadius="0" Padding="20" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,22,0"><TextBlock Text="采集进程工作集" Style="{StaticResource Caption}"/><TextBlock x:Name="memory" Text="—" Style="{StaticResource MetricValue}"/><TextBlock x:Name="privateMemory" Style="{StaticResource Caption}"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="连接与记录" FontWeight="SemiBold"/><TextBlock x:Name="gsi" TextWrapping="Wrap" Margin="0,10,0,5"/><TextBlock x:Name="hall" Style="{StaticResource Caption}"/><TextBlock x:Name="inputs" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
  </Grid></Border>
  <Border x:Name="cacheSection" Style="{StaticResource CardStyle}" Margin="0,0,0,20"><StackPanel>
   <DockPanel><Button x:Name="refreshCache" DockPanel.Dock="Right" Content="刷新占用" Click="RefreshCache_Click" Style="{StaticResource QuietButton}" Margin="16,0,0,0"/><TextBlock Text="存储与清理" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
   <Grid Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Demo 缓存占用" Style="{StaticResource Caption}"/><TextBlock x:Name="cacheSize" Text="—" Style="{StaticResource MetricValue}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="核对来源后可释放" Style="{StaticResource Caption}"/><TextBlock x:Name="cacheReclaimable" Text="—" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}"/></StackPanel></Grid>
   <TextBlock x:Name="cacheDetail" Text="正在核对缓存来源…" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
   <TextBlock Text="保留原始 Demo、对局记录、统计报告和同步索引。只清理能重建的解压副本及过期临时文件；再次分析时可能重新解压。" Style="{StaticResource Caption}"/>
   <WrapPanel Margin="0,18,0,0"><Button x:Name="cleanCache" Content="清理解压缓存" Click="CleanCache_Click" IsEnabled="False" Margin="0,0,16,8"/><TextBlock x:Name="protectedSize" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="cacheFeedback" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></Border>
  <Expander Header="采集与解析什么时候使用资源？"><StackPanel Margin="0,12,0,0"><TextBlock Text="未运行 CS2：每 3 秒检查一次，不打开键盘与输入接口。&#10;游戏中：记录按键、Hall 与比赛状态，每 5 秒保存一次。&#10;退出游戏后：扫描下载目录，解析 Demo，完成后释放解析进程。&#10;重新进入游戏：暂停 Demo 解析，未完成任务稍后继续。" Style="{StaticResource Caption}" LineHeight="27"/><TextBlock Text="上方内存仅统计采集进程，统计窗口和 Demo 解析另计。记录中的占用会随对局长度增加。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Expander>
  <Button Content="打开本地数据文件夹" Click="OpenData_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-10,16,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
