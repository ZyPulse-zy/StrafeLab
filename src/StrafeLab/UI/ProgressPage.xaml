<UserControl x:Class="StrafeLab.UI.ProgressPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:StrafeLab.UI">
 <UserControl.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#161C20"/><Setter Property="Foreground" Value="#E4EDF7"/><Setter Property="BorderBrush" Value="#3B4C4D"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,12,8"/><Setter Property="MinWidth" Value="85"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#C1D3E5"/><Setter Property="Margin" Value="0,12,0,4"/></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,12,0">  <WrapPanel>
   <StackPanel><TextBlock Text="观察多久" FontSize="11" Foreground="#9EAFAE" Margin="0,0,0,5"/><ComboBox x:Name="period" Width="118" SelectionChanged="Period_Changed"/></StackPanel>
   <StackPanel><TextBlock Text="只比较同一种武器、姿态和初速" FontSize="11" Foreground="#9EAFAE" Margin="0,0,0,5"/><ComboBox x:Name="cohort" Width="365" SelectedValuePath="Key" SelectionChanged="Cohort_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#E1EAE7"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
  </WrapPanel>
  <TextBlock x:Name="selectionNote" FontSize="11" Foreground="#9EAFAE" TextWrapping="Wrap" Margin="0,0,0,12"/>
</StackPanel>
 <ScrollViewer Grid.Row="1" x:Name="progressScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,6,12,20"><StackPanel x:Name="overviewPanel">  <Border Background="Transparent" BorderBrush="#30393F" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,0,0,14">
   <StackPanel>
    
    <TextBlock x:Name="headline" Text="先建立基线，再调整键盘" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,7" TextWrapping="Wrap"/>
    <TextBlock x:Name="coverage" Foreground="#B2C9DA" FontSize="13" TextWrapping="Wrap"/>
    <TextBlock x:Name="nextStep" Foreground="#E4CF9D" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,0"/>
   </StackPanel>
  </Border>
  <UniformGrid Columns="3" Margin="0,0,0,14">
   <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0"><StackPanel><TextBlock Text="相反两键同时按住" Foreground="#71D6C3" FontSize="13"/><TextBlock x:Name="overlapValue" FontSize="32" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock x:Name="overlapRange" FontSize="12" Foreground="#BACCDD"/><TextBlock Text="按下反向键后，两键重叠多久" FontSize="11" Foreground="#9EAFAE" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0"><StackPanel><TextBlock Text="两键都松开的空档" Foreground="#EFBD70" FontSize="13"/><TextBlock x:Name="gapValue" FontSize="32" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock x:Name="gapRange" FontSize="12" Foreground="#BACCDD"/><TextBlock Text="先松原键，再按反向键的间隔" FontSize="11" Foreground="#9EAFAE" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="换向后多久开枪" Foreground="#71AEFA" FontSize="13"/><TextBlock x:Name="clickValue" FontSize="32" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock x:Name="clickRange" FontSize="12" Foreground="#BACCDD"/><TextBlock Text="反向键按下到第一次按鼠标左键" FontSize="11" Foreground="#9EAFAE" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  </UniformGrid>
  <TextBlock x:Name="handoffSummary" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
  <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel>
   <TextBlock Text="逐局趋势" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock x:Name="trendSummary" TextWrapping="Wrap" Foreground="#BBCEDD" FontSize="12" Margin="0,8,0,8"/>
   <ComboBox x:Name="metric" Width="180" HorizontalAlignment="Left" SelectionChanged="Metric_Changed"/><local:ProgressChart x:Name="chart" Height="215"/>
   <TextBlock Text="每点一局；空心点不足 5 次，仅供观察。悬停查看数值与方案，点击进入本局动作。" FontSize="11" Foreground="#9EAFAE" TextWrapping="Wrap"/>
   <Expander Header="这些数字怎样理解？"><TextBlock Text="典型值取中位数；常见范围包含中间一半动作。范围变窄，说明交接或开枪节奏更一致，但这些时间并非越小越好，也不是建议你等固定毫秒后开枪。只比较同一组；初速低于 34 的动作仍不计入。" TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0"/></Expander>
  </StackPanel></Border>
  <TextBlock Text="每局记录 · 点击跳转到可核对的动作" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,9"/>
  <DataGrid x:Name="historyGrid" Height="186" SelectionChanged="History_Selected"><DataGrid.Columns>
   <DataGridTextColumn Header="时间" Binding="{Binding Label}" Width="118"/><DataGridTextColumn Header="同类动作" Binding="{Binding Count}" Width="75"/>
   <DataGridTextColumn Header="两键同按" Binding="{Binding Overlap.Typical}" Width="110"/><DataGridTextColumn Header="双键空档" Binding="{Binding Gap.Typical}" Width="110"/>
   <DataGridTextColumn Header="换向到开枪" Binding="{Binding Click.Typical}" Width="110"/><DataGridTextColumn Header="参数方案" Binding="{Binding Scheme}" Width="*"/>
  </DataGrid.Columns></DataGrid>
</StackPanel><StackPanel x:Name="parametersPanel" Visibility="Collapsed">  <Border x:Name="settingsSection" Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel>
   <TextBlock Text="键盘参数：现在该不该调？" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="adviceTitle" Foreground="#E9C88C" FontSize="17" Margin="0,10,0,6"/>
   <TextBlock x:Name="advice" Foreground="#C0D2E1" FontSize="13" TextWrapping="Wrap"/>
   <TextBlock x:Name="currentProfile" Foreground="#71D6C3" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
   <TextBlock Text="先在官方驱动手动调整，再来记下方案。每次只改一项，其余保持一致；用同类对局观察变化。程序不会替你改触发、RT 或灯光。" TextWrapping="Wrap" Foreground="#92A9C1" FontSize="12" Margin="0,10,0,0"/>
   <Expander IsExpanded="True" x:Name="profileEditor" Header="记录我现在实际使用的参数（或新方案）">
    <StackPanel Margin="0,10,0,0">
     <TextBlock x:Name="prefillNote" TextWrapping="Wrap" Foreground="#E4C88F" FontSize="12"/>
     <WrapPanel Margin="0,8,0,0">
      <StackPanel><TextBlock Text="方案名"/><TextBox x:Name="profileName" Width="155" MaxLength="60"/></StackPanel>
      <StackPanel><TextBlock Text="A/D 触发 · mm"/><TextBox x:Name="adTrigger" Width="110"/></StackPanel>
      <StackPanel><TextBlock Text="W/S 触发 · mm"/><TextBox x:Name="wsTrigger" Width="110"/></StackPanel>
      <StackPanel><TextBlock Text="RT 按下 · mm"/><TextBox x:Name="rtPress" Width="110"/></StackPanel>
      <StackPanel><TextBlock Text="RT 抬起 · mm"/><TextBox x:Name="rtRelease" Width="110"/></StackPanel>
     </WrapPanel>
     <TextBlock Text="其他设置 / 备注（回报率、模式、当日练习等）" FontSize="12"/><TextBox x:Name="profileNotes" MaxLength="1000" TextWrapping="Wrap"/>
     <Button Content="已在驱动应用，记录为当前方案" HorizontalAlignment="Left" Click="SaveProfile_Click"/>
     <TextBlock Text="保存后，只自动关联之后开始的对局。以前的对局不猜测参数；如果中途换过设置，请将那局标记为“未知 / 中途变更”。" FontSize="11" TextWrapping="Wrap" Foreground="#9EAFAE"/>
    </StackPanel>
   </Expander>
   <TextBlock x:Name="profileStatus" Foreground="#E9C88C" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel>
   <TextBlock Text="换参数前后，表现有没有差别？" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="只使用上方同一组动作；参数未知的对局不参与方案比较。3 局 / 30 次是收集数据的提示门槛，不保证统计结论可靠。" Foreground="#9EAFAE" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,10"/>
   <DataGrid x:Name="profileGrid" Height="142"><DataGrid.Columns>
    <DataGridTextColumn Header="方案" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="数据量" Binding="{Binding Coverage}" Width="110"/>
    <DataGridTextColumn Header="两键同按" Binding="{Binding Overlap.Typical}" Width="100"/><DataGridTextColumn Header="双键空档" Binding="{Binding Gap.Typical}" Width="100"/>
    <DataGridTextColumn Header="换向到开枪" Binding="{Binding Click.Typical}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/>
   </DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><TextBlock Text="旧方案" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="beforeProfile" Width="210" SelectionChanged="Comparison_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#E1EAE7"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="新方案" VerticalAlignment="Center" Margin="8,0,8,8"/><ComboBox x:Name="afterProfile" Width="210" SelectionChanged="Comparison_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#E1EAE7"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></WrapPanel>
   <TextBlock x:Name="comparisonText" TextWrapping="Wrap" Foreground="#BCD0E2" FontSize="13"/>
   <Expander Header="为过去的对局补记参数 / 标记中途变更">
    <StackPanel Margin="0,10,0,0"><TextBlock Text="只有确定当时用了这套参数才补记。选择“未知 / 中途变更”可把该局移出方案对比，原本的表现统计保留。" Foreground="#92A9C1" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <WrapPanel><ComboBox x:Name="assignmentMatch" Width="300"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#E1EAE7"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox x:Name="assignmentProfile" Width="220"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#E1EAE7"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="保存这局标记" Click="AssignProfile_Click"/></WrapPanel>
    </StackPanel>
   </Expander>
  </StackPanel></Border>
</StackPanel></StackPanel>
 </ScrollViewer></Grid>
</UserControl>
