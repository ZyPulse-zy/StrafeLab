<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.7.0</Version>
    <ApplicationIcon>Assets\StrafeLab.ico</ApplicationIcon>
    <Product>StrafeLab</Product>
    <Description>Local CS2 manual movement analysis</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tools\demo-extractor.py"
             Link="demo-extractor.py"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md"
             Link="README.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
